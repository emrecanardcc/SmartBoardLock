default_platform(:ios)

platform :ios do
  desc "Build Flutter iOS and upload to TestFlight via App Store Connect API Key"
  lane :beta do
    key_id = ENV["APP_STORE_KEY_ID"] || "9CPAA97QY7"
    issuer_id = ENV["APP_STORE_ISSUER_ID"] || "37cfcb1d-908a-4cba-922a-057b008cc424"
    key_path = ENV["APP_STORE_KEY_PATH"] || File.expand_path("~/AuthKey_9CPAA97QY7.p8")

    # 1. Setup App Store Connect API Key
    api_key = app_store_connect_api_key(
      key_id: key_id,
      issuer_id: issuer_id,
      key_filepath: key_path,
      in_house: false
    )

    # 2. Flutter IPA Build
    Dir.chdir("../..") do
      sh("flutter", "pub", "get")
      sh("flutter", "build", "ipa", "--release")
    end

    # 3. Upload to TestFlight
    upload_to_testflight(
      api_key: api_key,
      ipa: "../../build/ios/ipa/tahta_kumandasi.ipa",
      skip_waiting_for_build_processing: true
    )
  end
end
